# 后端环境变量示例 —— 复制为 .env 后填入自己的值（.env 已被 .gitignore 忽略）
# ⛔ 不要把真实凭据提交到仓库

# IM 平台应用凭据
IMT_APP_ID=
IMT_APP_SECRET=

# 事件回调验签与解密（平台后台取得，务必按原样使用，先 base64 解码反而解不开）
IMT_ENCRYPT_KEY=
IMT_VERIFY_TOKEN=

# 端口：公开端（事件回调 + H5）/ 管理端
IMT_PUBLIC_PORT=9012
IMT_ADMIN_PORT=9013

# 对外可访问地址（H5 提交链接的域名前缀）
IMT_PUBLIC_BASE_URL=http://127.0.0.1:9012
