# 后端环境变量示例 —— 复制为 .env 后填入自己的值（.env 已被 .gitignore 忽略）
# ⛔ 不要把真实凭据提交到仓库

# IM 平台应用凭据
IMT_APP_ID=
IMT_APP_SECRET=

# 事件回调验签与解密（平台后台取得，务必按原样使用，先 base64 解码反而解不开）
IMT_ENCRYPT_KEY=
IMT_VERIFY_TOKEN=

# 端口：公开端（事件回调 + H5）/ 管理端
IMT_PUBLIC_PORT=9020
IMT_ADMIN_PORT=9013

# 对外可访问地址（H5 提交链接的域名前缀）
IMT_PUBLIC_BASE_URL=http://127.0.0.1:9020

# ---- MySQL 数据库（2026-11-16 方案B：全栈纯 MySQL，SQLite 已彻底移除） ----
# 连接参数（.env 填好后由 app/config.py 自动加载）
IMT_MYSQL_HOST=127.0.0.1
IMT_MYSQL_PORT=3306
IMT_MYSQL_USER=imtask
IMT_MYSQL_PASSWORD=
IMT_MYSQL_DATABASE=im_task

# 连接池（可选，默认即可）
# IMT_MYSQL_MINCACHED=2
# IMT_MYSQL_MAXCONNECTIONS=16

# ---- 测试底座（可选，tests/conftest.py 专用；默认本机 root/im_task_test） ----
# ⛔ 熔断锁铁律：测试库名必须以 _test 结尾、Host 必须本机，否则 pytest 直接中止
# IMT_TEST_MYSQL_HOST=127.0.0.1
# IMT_TEST_MYSQL_PORT=3306
# IMT_TEST_MYSQL_USER=root
# IMT_TEST_MYSQL_PASSWORD=
# IMT_TEST_MYSQL_DATABASE=im_task_test
